{
  "expo": {
    "name": "keesha",
    "slug": "keesha",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/wallet-icon.png",
    "scheme": "keesha",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/wallet-icon.png"
    },
    "android": {
      "package": "com.keesha.app",
      "versionCode": 4,
      "icon": "./assets/images/wallet-icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#176346",
        "foregroundImage": "./assets/images/wallet-adaptive-foreground.png",
        "monochromeImage": "./assets/images/wallet-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": "production"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a profile picture for your Keesha account.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "a3f4c02e-a554-44d7-8ae8-67ef54c0971e"
      }
    },
    "owner": "arun_babu"
  }
}
