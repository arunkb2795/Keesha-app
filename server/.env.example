DATABASE_URL=
# Optional direct URL for Drizzle Kit migrations. The runtime uses DATABASE_URL.
# DATABASE_URL_UNPOOLED=
CLERK_SECRET_KEY=
# The exact issuer of your Clerk session tokens, e.g. https://example.clerk.accounts.dev
CLERK_ISSUER=
# Set only when configured in Clerk session token claims
# CLERK_AUDIENCE=
# Comma-separated browser origins. Native tokens can omit azp.
# CLERK_AUTHORIZED_PARTIES=http://localhost:8081
# Random secret of at least 32 characters for signing pagination cursors
CURSOR_SECRET=
HOST=127.0.0.1
PORT=3000
